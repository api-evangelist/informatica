          "id": "cc6c121e-dc6b-4731-aa50-d41b08fc2b71",
          "name": "Informatica Retrieve Activity Log Entries for Jobs",
          "request": {
            "name": "Informatica Retrieve Activity Log Entries for Jobs",
            "description": {
              "content": "Returns activity log entries for completed and running jobs in the organization. Results can be filtered by run ID, task ID, or other criteria.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "saas",
                "api",
                "v2",
                "activity",
                "activityLog"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "runId",
                  "value": "<long>",
                  "description": "Filter by the job run ID."
                },
                {
                  "disabled": false,
                  "key": "taskId",
                  "value": "<string>",
                  "description": "Filter by the task ID."
                },
                {
                  "disabled": false,
                  "key": "taskType",
                  "value": "<string>",
                  "description": "Filter by task type (e.g., MTT for mapping task, WORKFLOW for taskflow)."
                },
                {
                  "disabled": false,
                  "key": "startTimeUTC",
                  "value": "<dateTime>",
                  "description": "Filter for jobs started after this UTC timestamp in ISO 8601 format."
                },
                {
                  "disabled": false,
                  "key": "endTimeUTC",
                  "value": "<dateTime>",
                  "description": "Filter for jobs completed before this UTC timestamp in ISO 8601 format."
                }
